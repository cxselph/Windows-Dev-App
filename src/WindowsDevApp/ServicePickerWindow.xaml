<Window x:Class="WindowsDevApp.ServicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select a Windows Service" Height="500" Width="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="0,0,0,8" TextChanged="FilterBox_TextChanged"
                 ToolTip="Filter by service name"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="ServicesListBox" DisplayMemberPath="DisplayName" MouseDoubleClick="ServicesListBox_MouseDoubleClick"/>
    </DockPanel>
</Window>
