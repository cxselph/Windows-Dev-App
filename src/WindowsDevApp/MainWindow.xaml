<Window x:Class="WindowsDevApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dev App" Height="740" Width="1120" MinHeight="560" MinWidth="900"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top: GitHub auth bar -->
        <Border DockPanel.Dock="Top" Background="#1f2430" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="GitHub:" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>

                <StackPanel x:Name="LoggedOutPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <PasswordBox x:Name="TokenBox" Width="360" Margin="0,0,8,0" ToolTip="GitHub Personal Access Token"/>
                    <Button x:Name="LoginButton" Content="Login" Click="LoginButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="LoggedInPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="LoggedInLabel" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="LogoutButton" Content="Log out" Click="LogoutButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="GitHubStatusText" Grid.Column="2" Foreground="#ffb454" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Profiles -->
            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="Profiles" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="AddProfileButton" Content="Add" Click="AddProfileButton_Click"/>
                    <Button x:Name="DeleteProfileButton" Content="Delete" Click="DeleteProfileButton_Click"/>
                </StackPanel>

                <ListBox x:Name="ProfilesList" DockPanel.Dock="Top" Height="130" Margin="0,0,0,10"
                         SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name"/>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProfileEditorPanel" IsEnabled="False">
                        <TextBlock Text="Profile name" FontWeight="SemiBold"/>
                        <TextBox x:Name="ProfileNameBox" Margin="0,2,0,10"/>

                        <TextBlock Text="Local repo folder" FontWeight="SemiBold"/>
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RepoPathBox" Grid.Column="0"/>
                            <Button x:Name="BrowseRepoButton" Grid.Column="1" Content="Browse" Margin="6,0,0,0" Click="BrowseRepoButton_Click"/>
                        </Grid>

                        <TextBlock Text=".env file path" FontWeight="SemiBold"/>
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EnvPathBox" Grid.Column="0"/>
                            <Button x:Name="BrowseEnvButton" Grid.Column="1" Content="Browse" Margin="6,0,0,0" Click="BrowseEnvButton_Click"/>
                        </Grid>

                        <TextBlock Text="Windows service name" FontWeight="SemiBold"/>
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServiceNameBox" Grid.Column="0"/>
                            <Button x:Name="PickServiceButton" Grid.Column="1" Content="Pick..." Margin="6,0,0,0" Click="PickServiceButton_Click"/>
                        </Grid>

                        <Button x:Name="SaveProfileButton" Content="Save profile" Margin="0,6,0,0" Click="SaveProfileButton_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Right: Tabs -->
            <TabControl x:Name="MainTabs" Grid.Column="1" Margin="0,10,10,10" IsEnabled="False">
                <TabItem Header="Branches">
                    <DockPanel Margin="10">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="RefreshBranchesButton" Content="Refresh (fetch)" Click="RefreshBranchesButton_Click"/>
                            <Button x:Name="CheckoutButton" Content="Checkout selected" Click="CheckoutButton_Click"/>
                            <Button x:Name="PullButton" Content="Pull / Update" Click="PullButton_Click"/>
                            <Button x:Name="ForceSyncButton" Content="Force sync to remote" Click="ForceSyncButton_Click"
                                    ToolTip="Discards local changes and resets the current branch to exactly match origin"/>
                            <Button x:Name="CleanupBranchesButton" Content="Clean up merged branches" Click="CleanupBranchesButton_Click"
                                    ToolTip="Deletes local branches already merged into the current branch"/>
                            <Button x:Name="DeleteBranchButton" Content="Delete branch" Click="DeleteBranchButton_Click"
                                    ToolTip="Deletes the selected local branch, regardless of merge status"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="CurrentBranchText" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="BranchStatusText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <ListBox x:Name="BranchesList"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Environment File">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <Button DockPanel.Dock="Top" x:Name="ReloadEnvButton" Content="Reload from file" Margin="0,0,0,10"
                                    Click="ReloadEnvButton_Click" HorizontalAlignment="Left"/>
                            <ListBox x:Name="EnvFieldsList" DisplayMemberPath="Key" SelectionChanged="EnvFieldsList_SelectionChanged"/>
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock DockPanel.Dock="Top" x:Name="EnvSelectedKeyText" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Button DockPanel.Dock="Bottom" x:Name="SaveEnvButton" Content="Save value" Margin="0,10,0,0"
                                    Click="SaveEnvButton_Click" HorizontalAlignment="Left"/>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="EnvStatusText" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBox x:Name="EnvValueBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Windows Service">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="ServiceDisplayText" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ServiceStatusLabel" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RefreshServiceButton" Content="Refresh status" Click="RefreshServiceButton_Click"/>
                            <Button x:Name="RestartServiceButton" Content="Restart service" Click="RestartServiceButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ServiceOpStatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
